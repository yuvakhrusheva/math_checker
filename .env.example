# =============================================================================
# math_checker — required environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# =============================================================================

# Path to the Google service account JSON key file.
# IMPORTANT:
#   - Must be an ABSOLUTE path (e.g. C:\Users\you\keys\math_checker_sa.json)
#   - The file must exist on disk before starting the app
#   - Keep this file OUTSIDE the repository root
#   - Set file permissions to read-only for your user only
GOOGLE_SERVICE_ACCOUNT_JSON=/absolute/path/to/service_account.json

# API key for your LLM provider (Anthropic, OpenAI, Google, or OpenRouter).
# Only the key for the model configured in config/settings.json is required.
# For OpenRouter, set the model in settings.json to "openrouter/<vendor>/<model>",
# e.g. "openrouter/google/gemini-2.5-flash" or "openrouter/anthropic/claude-sonnet-4.5".
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# (Optional) Google Drive folder ID for integration tests.
# Only needed when running pytest tests/integration/
# TEST_GDRIVE_FOLDER_ID=your_test_folder_id_here

# =============================================================================
# Database connection (added in DB migration to SQLAlchemy)
# =============================================================================

# Локально для разработки оставь пустой строкой — будет использоваться SQLite
# из data/math_checker.db (как раньше).
#
# Для продакшена (Postgres) укажи полный URL, например:
# DATABASE_URL=postgresql://user:password@host:5432/math_checker
DATABASE_URL=
```
SEED_PASSWORD_LIZA="пароль"
OPENROUTER_API_KEY=